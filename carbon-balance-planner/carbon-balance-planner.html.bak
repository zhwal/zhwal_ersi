<!-- IconPark SVG Icons (ByteDance open-source: https://github.com/bytedance/IconPark) -->
<script type="module">
import ChartLine from 'https://unpkg.com/@icon-park/svg@1.4.2/es/icons/ChartLine.js';
import Leaf from 'https://unpkg.com/@icon-park/svg@1.4.2/es/icons/Leaf.js';
import Balance from 'https://unpkg.com/@icon-park/svg@1.4.2/es/icons/Balance.js';
import Undo from 'https://unpkg.com/@icon-park/svg@1.4.2/es/icons/Undo.js';
import Caution from 'https://unpkg.com/@icon-park/svg@1.4.2/es/icons/Caution.js';
import AreaMap from 'https://unpkg.com/@icon-park/svg@1.4.2/es/icons/AreaMap.js';
import City from 'https://unpkg.com/@icon-park/svg@1.4.2/es/icons/City.js';
import Thermometer from 'https://unpkg.com/@icon-park/svg@1.4.2/es/icons/Thermometer.js';
import People from 'https://unpkg.com/@icon-park/svg@1.4.2/es/icons/People.js';

const ICONS = { ChartLine, Leaf, Balance, Undo, Caution, AreaMap, City, Thermometer, People };

function renderIconPark(el) {
  const name = el.dataset.iconpark;
  const icon = ICONS[name];
  if (!icon) return;
  const size = parseInt(el.dataset.size, 10) || 20;
  const fill = el.dataset.fill || 'currentColor';
  el.innerHTML = icon({ theme: 'outline', size: size, fill: fill, strokeWidth: 3 });
}

document.querySelectorAll('[data-iconpark]').forEach(renderIconPark);
</script>

<style>
/* ===== Fonts ===== */
@font-face {
  font-family: 'BricolageGrotesque';
  src: url('../story-framework/_shared/fonts/BricolageGrotesque-Bold.ttf') format('truetype');
  font-weight: 700;
}
@font-face {
  font-family: 'BricolageGrotesque';
  src: url('../story-framework/_shared/fonts/BricolageGrotesque-Regular.ttf') format('truetype');
  font-weight: 400;
}
@font-face {
  font-family: 'CrimsonPro';
  src: url('../story-framework/_shared/fonts/CrimsonPro-Regular.ttf') format('truetype');
  font-weight: 400;
}
@font-face {
  font-family: 'CrimsonPro';
  src: url('../story-framework/_shared/fonts/CrimsonPro-Italic.ttf') format('truetype');
  font-weight: 400;
  font-style: italic;
}
@font-face {
  font-family: 'JetBrainsMono';
  src: url('../story-framework/_shared/fonts/JetBrainsMono-Regular.ttf') format('truetype');
  font-weight: 400;
}

/* ===== Design Tokens ===== */
:root {
  --bg: #F5F0E8;
  --bg2: #FFFFFF;
  --ink: #2A241E;
  --ink2: #3D362D;
  --muted: #8A8070;
  --rule: #D8D0C0;
  --accent: #4A6741;
  --accent-dark: #1F2E1A;
  --accent-light: #8BA88A;
  --accent2: #5B8C5A;
  --warm: #8B6E5A;
  --warm2: #C4A882;
  --warn: #C47A3A;
  --danger: #B8453A;
  --celadon: #B0C4A8;
  --stone: #D4CFC4;
  --font: 'CrimsonPro', 'Noto Sans CJK SC', 'Microsoft YaHei', serif;
  --font-heading: 'BricolageGrotesque', 'Noto Sans CJK SC', 'Microsoft YaHei', sans-serif;
  --font-mono: 'JetBrainsMono', 'Consolas', 'Courier New', monospace;
  --panel-w: 320px;
  --dash-w: 310px;
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 12px;
  --shadow-sm: 0 1px 3px rgba(0,0,0,0.06);
  --shadow-md: 0 4px 12px rgba(0,0,0,0.08);
  --shadow-lg: 0 8px 24px rgba(0,0,0,0.1);
  --transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-fast: 0.15s cubic-bezier(0.4, 0, 0.2, 1);
}

/* ===== IconPark Icons ===== */
.iconpark-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  vertical-align: middle;
  flex-shrink: 0;
}
.iconpark-icon svg {
  width: 1em;
  height: 1em;
  display: block;
}
.iconpark-icon svg [fill] { fill: currentColor; }
.iconpark-icon svg [stroke] { stroke: currentColor; }

/* ===== Reset & Base ===== */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; overflow: hidden; }
html { font-size: 16px; }
body {
  font-family: var(--font);
  font-size: 14px;
  line-height: 1.6;
  color: var(--ink);
  background: var(--bg);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ===== Focus Styles ===== */
:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
  border-radius: var(--radius-sm);
}

/* ===== App Shell ===== */
.app {
  display: flex;
  height: 100vh;
  height: 100dvh;
  width: 100vw;
  width: 100dvw;
}

/* ===== Left Panel: Controls ===== */
.panel-left {
  width: var(--panel-w);
  min-width: var(--panel-w);
  max-width: var(--panel-w);
  background: var(--bg2);
  border-right: 1px solid var(--rule);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  z-index: 10;
  box-shadow: var(--shadow-sm);
}

.panel-header {
  background: linear-gradient(165deg, var(--accent-dark) 0%, #2A3D24 50%, #1A2A16 100%);
  color: #E8E5D8;
  padding: 1.4rem 1.5rem;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
}
.panel-header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--accent-light), var(--accent2), var(--accent-light));
  opacity: 0.6;
}
.panel-header h1 {
  font-family: var(--font-heading);
  font-size: 1.15rem;
  font-weight: 700;
  line-height: 1.3;
  letter-spacing: -0.01em;
}
.panel-header .tagline {
  font-size: 0.72rem;
  opacity: 0.7;
  margin-top: 0.25rem;
  font-style: italic;
  font-family: var(--font);
}

.panel-body {
  padding: 1.3rem 1.5rem;
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  scroll-behavior: smooth;
}
.panel-body::-webkit-scrollbar { width: 5px; }
.panel-body::-webkit-scrollbar-track { background: transparent; }
.panel-body::-webkit-scrollbar-thumb { background: var(--rule); border-radius: 3px; }

/* ===== Control Groups ===== */
.control-group {
  margin-bottom: 1.6rem;
  padding: 1rem;
  background: rgba(245,240,232,0.4);
  border-radius: var(--radius-md);
  border: 1px solid transparent;
  transition: border-color var(--transition-fast);
}
.control-group:hover {
  border-color: var(--rule);
}
.control-group:focus-within {
  border-color: var(--accent-light);
  background: rgba(74,103,65,0.03);
}
.control-group:last-child { margin-bottom: 0.5rem; }

.control-label {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0.35rem;
  gap: 0.5rem;
}
.control-label .name {
  font-family: var(--font-heading);
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 0.01em;
  display: flex;
  align-items: center;
  gap: 0.2rem;
}
.control-label .value {
  font-family: var(--font-mono);
  font-size: 0.85rem;
  font-weight: 700;
  color: var(--accent);
  background: rgba(74,103,65,0.08);
  padding: 3px 10px;
  border-radius: var(--radius-sm);
  min-width: 52px;
  text-align: center;
  letter-spacing: -0.02em;
  transition: all var(--transition-fast);
  flex-shrink: 0;
}

.control-desc {
  font-size: 0.72rem;
  color: var(--muted);
  margin-bottom: 0.5rem;
  line-height: 1.45;
}

/* ===== Info Tip ===== */
.info-tip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 17px;
  height: 17px;
  border-radius: 50%;
  background: var(--rule);
  color: var(--muted);
  font-size: 0.65rem;
  font-weight: 700;
  cursor: help;
  flex-shrink: 0;
  position: relative;
  font-family: var(--font-heading);
  line-height: 1;
  transition: all var(--transition-fast);
}
.info-tip:hover,
.info-tip:focus-visible {
  background: var(--accent);
  color: #fff;
}
.info-tip:hover::after,
.info-tip:focus-visible::after {
  content: attr(data-tip);
  position: absolute;
  bottom: calc(100% + 8px);
  left: 50%;
  transform: translateX(-50%);
  background: var(--ink);
  color: #fff;
  padding: 0.5rem 0.75rem;
  border-radius: var(--radius-sm);
  font-size: 0.7rem;
  font-weight: 400;
  white-space: nowrap;
  pointer-events: none;
  z-index: 200;
  font-family: var(--font);
  line-height: 1.4;
  box-shadow: var(--shadow-md);
}

/* ===== Sliders ===== */
.slider-wrapper {
  position: relative;
}
input[type="range"] {
  -webkit-appearance: none;
  appearance: none;
  width: 100%;
  height: 8px;
  border-radius: 4px;
  background: linear-gradient(90deg, var(--accent-light) 0%, var(--accent) 50%, var(--accent-dark) 100%);
  outline: none;
  cursor: pointer;
  transition: opacity var(--transition-fast);
}
input[type="range"]:hover {
  opacity: 0.9;
}
input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: var(--accent);
  border: 2.5px solid var(--bg2);
  box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  cursor: pointer;
  transition: transform var(--transition-fast), background var(--transition-fast);
}
input[type="range"]::-webkit-slider-thumb:hover {
  transform: scale(1.15);
  background: var(--accent-dark);
}
input[type="range"]::-webkit-slider-thumb:active {
  transform: scale(1.1);
  background: var(--accent-dark);
}
input[type="range"]::-moz-range-thumb {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: var(--accent);
  border: 2.5px solid var(--bg2);
  box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  cursor: pointer;
}

.slider-marks {
  display: flex;
  justify-content: space-between;
  font-size: 0.65rem;
  color: var(--muted);
  margin-top: 0.3rem;
  padding: 0 2px;
  font-family: var(--font-mono);
}

/* ===== Section Divider ===== */
.section-divider {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  margin: 1.5rem 0 0.8rem;
  color: var(--muted);
  font-family: var(--font-heading);
  font-size: 0.7rem;
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.section-divider::before,
.section-divider::after {
  content: '';
  flex: 1;
  height: 1px;
  background: var(--rule);
}

/* ===== Scenario Buttons ===== */
.scenario-group {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin: 0.3rem 0 1rem;
}

.btn-scenario {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.7rem 0.9rem;
  border: 1.5px solid var(--rule);
  border-radius: var(--radius-md);
  background: var(--bg2);
  cursor: pointer;
  font-family: var(--font-heading);
  font-size: 0.82rem;
  font-weight: 700;
  color: var(--ink2);
  transition: all var(--transition-fast);
  text-align: left;
  width: 100%;
}
.btn-scenario:hover {
  border-color: var(--accent-light);
  background: rgba(74,103,65,0.04);
  transform: translateX(2px);
}
.btn-scenario:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}
.btn-scenario.active {
  border-color: var(--accent);
  background: rgba(74,103,65,0.07);
  color: var(--accent-dark);
  box-shadow: 0 0 0 3px rgba(74,103,65,0.08);
}
.btn-scenario .sc-icon {
  font-size: 1.2rem;
  flex-shrink: 0;
  width: 28px;
  text-align: center;
}
.btn-scenario .sc-info {
  flex: 1;
  min-width: 0;
}
.btn-scenario .sc-name {
  font-size: 0.84rem;
  line-height: 1.2;
}
.btn-scenario .sc-desc {
  font-size: 0.66rem;
  color: var(--muted);
  font-family: var(--font);
  font-weight: 400;
  line-height: 1.3;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.btn-reset {
  width: 100%;
  padding: 0.6rem;
  border: 1px solid var(--rule);
  border-radius: var(--radius-md);
  background: var(--bg);
  cursor: pointer;
  font-family: var(--font-heading);
  font-size: 0.78rem;
  font-weight: 700;
  color: var(--muted);
  transition: all var(--transition-fast);
  margin-top: 0.3rem;
  letter-spacing: 0.02em;
}
.btn-reset:hover {
  color: var(--ink);
  border-color: var(--muted);
  background: var(--bg2);
}

/* ===== Center: Map Area ===== */
.map-area {
  flex: 1;
  position: relative;
  background: #EAE5D8;
  min-width: 0;
  overflow: hidden;
}
#map-container {
  width: 100%;
  height: 100%;
}

/* Map overlay */
.map-overlay {
  position: absolute;
  bottom: 1rem;
  left: 1rem;
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  padding: 0.5rem 0.9rem;
  border-radius: var(--radius-md);
  font-size: 0.7rem;
  color: var(--muted);
  box-shadow: var(--shadow-sm);
  pointer-events: none;
  z-index: 100;
  font-family: var(--font-heading);
  letter-spacing: 0.02em;
}
.map-overlay strong { color: var(--ink); font-weight: 700; }

/* Map legend */
.map-legend {
  position: absolute;
  top: 1rem;
  right: 1rem;
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  padding: 0.6rem 0.8rem;
  border-radius: var(--radius-md);
  font-size: 0.68rem;
  box-shadow: var(--shadow-sm);
  z-index: 100;
  font-family: var(--font-heading);
  color: var(--ink2);
  display: none;
}
.map-legend.visible { display: block; }
.map-legend .legend-item {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  margin: 0.2rem 0;
}
.map-legend .legend-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  flex-shrink: 0;
}

/* Map loading / error states */
.map-overlay-state {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 50;
  pointer-events: none;
}
.map-overlay-state.hidden { display: none; }
.map-state-bg {
  position: absolute;
  inset: 0;
  background: rgba(245,240,232,0.85);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
}
.map-state-content {
  position: relative;
  z-index: 1;
  text-align: center;
  padding: 2rem;
}
.map-state-icon {
  font-size: 2.5rem;
  margin-bottom: 0.8rem;
  display: block;
}
.map-state-title {
  font-family: var(--font-heading);
  font-size: 1rem;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 0.3rem;
}
.map-state-desc {
  font-size: 0.8rem;
  color: var(--muted);
  max-width: 280px;
  line-height: 1.5;
}
.map-state-desc code {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  background: rgba(74,103,65,0.08);
  padding: 1px 6px;
  border-radius: 3px;
  color: var(--accent);
}

/* Map spinner */
.map-spinner {
  width: 32px;
  height: 32px;
  border: 3px solid var(--rule);
  border-top-color: var(--accent);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin: 0 auto 0.8rem;
}
@keyframes spin { to { transform: rotate(360deg); } }

/* ===== Right Panel: Dashboard ===== */
.panel-right {
  width: var(--dash-w);
  min-width: var(--dash-w);
  max-width: var(--dash-w);
  background: var(--bg2);
  border-left: 1px solid var(--rule);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  z-index: 10;
  box-shadow: var(--shadow-sm);
}

.dash-header {
  background: linear-gradient(165deg, var(--accent-dark) 0%, #2A3D24 100%);
  color: #E8E5D8;
  padding: 0.9rem 1.5rem;
  flex-shrink: 0;
  position: relative;
}
.dash-header::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--accent2), var(--accent-light));
  opacity: 0.5;
}
.dash-header h2 {
  font-family: var(--font-heading);
  font-size: 0.88rem;
  font-weight: 700;
  letter-spacing: 0.02em;
}

.dash-body {
  padding: 1.2rem 1.5rem;
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
}
.dash-body::-webkit-scrollbar { width: 5px; }
.dash-body::-webkit-scrollbar-track { background: transparent; }
.dash-body::-webkit-scrollbar-thumb { background: var(--rule); border-radius: 3px; }

/* ===== Score Display ===== */
.score-section {
  text-align: center;
  margin-bottom: 1rem;
  position: relative;
}

.score-ring {
  display: inline-block;
  position: relative;
  margin-bottom: 0.4rem;
}
.score-value {
  font-family: var(--font-heading);
  font-size: 3.6rem;
  font-weight: 700;
  color: var(--accent);
  line-height: 1;
  transition: color 0.5s ease;
  letter-spacing: -0.02em;
}
.score-value.warning { color: var(--warn); }
.score-value.danger { color: var(--danger); }
.score-value .score-max {
  font-size: 1.2rem;
  color: var(--muted);
  font-weight: 400;
  margin-left: 0.1rem;
}
.score-label {
  font-size: 0.7rem;
  color: var(--muted);
  margin-top: 0.1rem;
  letter-spacing: 0.04em;
  font-family: var(--font-heading);
}

.score-grade {
  display: inline-block;
  font-family: var(--font-heading);
  font-size: 0.82rem;
  font-weight: 700;
  padding: 0.35rem 0.9rem;
  border-radius: var(--radius-sm);
  margin: 0.3rem auto 0.8rem;
  letter-spacing: 0.03em;
  transition: all var(--transition-fast);
}
.grade-A { background: rgba(74,103,65,0.12); color: var(--accent); }
.grade-B { background: rgba(91,140,90,0.1); color: var(--accent2); }
.grade-C { background: rgba(196,122,58,0.1); color: var(--warn); }
.grade-D { background: rgba(184,69,58,0.1); color: var(--danger); }

/* ===== Chart Containers ===== */
.chart-box {
  margin-bottom: 1.1rem;
}
.chart-box h3 {
  font-family: var(--font-heading);
  font-size: 0.7rem;
  font-weight: 700;
  color: var(--muted);
  letter-spacing: 0.05em;
  margin-bottom: 0.4rem;
  text-transform: uppercase;
}
.chart-container {
  width: 100%;
  height: 160px;
  background: rgba(245,240,232,0.3);
  border-radius: var(--radius-sm);
}
.chart-container-large {
  height: 200px;
}

/* ===== Path Breakdown ===== */
.path-section {
  margin-top: 0.5rem;
}
.path-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.45rem 0.6rem;
  border-bottom: 1px solid var(--rule);
  font-size: 0.78rem;
  transition: background var(--transition-fast);
  border-radius: var(--radius-sm);
}
.path-item:hover {
  background: rgba(74,103,65,0.03);
}
.path-item:last-child { border-bottom: none; }
.path-item .path-icon {
  margin-right: 0.3rem;
  font-size: 0.9rem;
}
.path-item .path-name {
  color: var(--ink);
  font-weight: 600;
  display: flex;
  align-items: center;
  gap: 0.3rem;
}
.path-item .path-weight {
  font-size: 0.65rem;
  color: var(--muted);
  font-family: var(--font-mono);
}
.path-item .path-score {
  font-family: var(--font-mono);
  font-weight: 700;
  color: var(--accent);
  font-size: 0.9rem;
  transition: color var(--transition-fast);
}
.path-item .path-score.warning { color: var(--warn); }
.path-item .path-score.danger { color: var(--danger); }

.path-item .path-bar-bg {
  flex: 1;
  height: 6px;
  background: var(--rule);
  border-radius: 3px;
  margin: 0 0.6rem;
  overflow: hidden;
  min-width: 40px;
}
.path-item .path-bar-fill {
  height: 100%;
  border-radius: 3px;
  background: var(--accent);
  transition: width var(--transition);
}

/* ===== Narrative ===== */
.narrative {
  margin-top: 1rem;
  padding: 0.9rem;
  background: rgba(74,103,65,0.04);
  border-radius: var(--radius-md);
  border-left: 3px solid var(--accent-light);
  font-size: 0.78rem;
  color: var(--ink2);
  line-height: 1.65;
  font-style: italic;
  min-height: 60px;
  transition: all var(--transition);
}

/* ===== Tooltip info bar ===== */
.info-bar {
  margin-top: 0.8rem;
  padding: 0.6rem 0.8rem;
  background: rgba(139, 106, 90, 0.06);
  border-radius: var(--radius-sm);
  font-size: 0.68rem;
  color: var(--muted);
  line-height: 1.5;
  font-family: var(--font);
}
.info-bar strong {
  color: var(--warm);
  font-weight: 700;
}

/* ===== Responsive ===== */
@media (max-width: 1200px) {
  :root {
    --panel-w: 280px;
    --dash-w: 280px;
  }
  .panel-header h1 { font-size: 1rem; }
  .score-value { font-size: 2.8rem; }
  .chart-container { height: 140px; }
}

@media (max-width: 900px) {
  .app { flex-direction: column; }
  .panel-left {
    width: 100%;
    min-width: 100%;
    max-width: 100%;
    max-height: 38vh;
    border-right: none;
    border-bottom: 1px solid var(--rule);
  }
  .panel-right {
    width: 100%;
    min-width: 100%;
    max-width: 100%;
    max-height: 35vh;
    border-left: none;
    border-top: 1px solid var(--rule);
  }
  .map-area { flex: 1; min-height: 27vh; }
  .panel-body { padding: 0.8rem 1rem; }
  .dash-body { padding: 0.8rem 1rem; }
  .control-group { margin-bottom: 0.8rem; padding: 0.7rem; }
  .score-value { font-size: 2.2rem; }
  .chart-container { height: 120px; }
}

@media (max-width: 480px) {
  .panel-header h1 { font-size: 0.9rem; }
  .btn-scenario { padding: 0.5rem 0.7rem; font-size: 0.72rem; }
  .scenario-group { gap: 0.3rem; }
  .control-group { padding: 0.5rem; margin-bottom: 0.5rem; }
  .score-value { font-size: 1.8rem; }
}

/* ===== Print Styles ===== */
@media print {
  .app { display: block; height: auto; }
  .map-area { display: none; }
  .panel-left, .panel-right { width: 100%; max-width: 100%; }
}

/* ===== Reduced Motion ===== */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
</style>
</head>
<body>

<div class="app" role="main" aria-label="碳平衡规划师交互应用">

  <!-- ===== LEFT PANEL: Controls ===== -->
  <aside class="panel-left" role="complementary" aria-label="参数控制面板">
    <div class="panel-header">
      <h1>碳平衡规划师</h1>
      <p class="tagline">拖动滑块，规划你的低碳苏州</p>
    </div>

    <div class="panel-body">
      <!-- Slider 1: 建筑高度约束 -->
      <div class="control-group">
        <div class="control-label">
          <span class="name">
            路径一：建筑高度约束
            <span class="info-tip" data-tip="对应第三章路径一：限高令→低层形态→省电。权重45%，为三条路径中最强碳避免路径。" tabindex="0" role="tooltip" aria-label="路径一说明">?</span>
          </span>
          <span class="value" id="val-height" aria-live="polite">24m</span>
        </div>
        <p class="control-desc">古城建筑限高（当前24m→宽松60m），越低越省电，古城低层形态比高层节省约25%运行能耗</p>
        <div class="slider-wrapper">
          <input type="range" id="slider-height" min="12" max="60" value="24" step="2"
                 aria-label="建筑高度约束滑块，范围12到60米" aria-valuemin="12" aria-valuemax="60" aria-valuenow="24" aria-valuetext="24米">
          <div class="slider-marks"><span>12m</span><span>24m</span><span>36m</span><span>48m</span><span>60m</span></div>
        </div>
      </div>

      <!-- Slider 2: 绿地覆盖率 -->
      <div class="control-group">
        <div class="control-label">
          <span class="name">
            路径二：绿地覆盖率
            <span class="info-tip" data-tip="对应第三章路径二：冷岛效应→省空调。权重45%。园林降温3.3–3.7°C，为周边节省约10%–17%制冷能耗。" tabindex="0" role="tooltip" aria-label="路径二说明">?</span>
          </span>
          <span class="value" id="val-green" aria-live="polite">38%</span>
        </div>
        <p class="control-desc">全市绿地覆盖率，越高冷岛效应越强，降温辐射范围从200m扩展至400m以上</p>
        <div class="slider-wrapper">
          <input type="range" id="slider-green" min="20" max="70" value="38" step="1"
                 aria-label="绿地覆盖率滑块，范围20%到70%" aria-valuemin="20" aria-valuemax="70" aria-valuenow="38" aria-valuetext="38%">
          <div class="slider-marks"><span>20%</span><span>30%</span><span>40%</span><span>50%</span><span>70%</span></div>
        </div>
      </div>

      <!-- Slider 3: 慢行网络覆盖率 -->
      <div class="control-group">
        <div class="control-label">
          <span class="name">
            路径三：慢行网络覆盖率
            <span class="info-tip" data-tip="对应第三章路径三：步行替代驾车→交通减排。权重10%（效应微弱）。八园合计年均碳避免仅约18.3吨。" tabindex="0" role="tooltip" aria-label="路径三说明">?</span>
          </span>
          <span class="value" id="val-walk" aria-live="polite">45%</span>
        </div>
        <p class="control-desc">步行+骑行网络覆盖，步行替代驾车减排，但交通维度碳避免总量有限</p>
        <div class="slider-wrapper">
          <input type="range" id="slider-walk" min="20" max="90" value="45" step="1"
                 aria-label="慢行网络覆盖率滑块，范围20%到90%" aria-valuemin="20" aria-valuemax="90" aria-valuenow="45" aria-valuetext="45%">
          <div class="slider-marks"><span>20%</span><span>40%</span><span>60%</span><span>80%</span><span>90%</span></div>
        </div>
      </div>

      <!-- Scenario Presets -->
      <div class="section-divider">情景预设</div>
      <div class="scenario-group" role="radiogroup" aria-label="情景预设">
        <button class="btn-scenario active" data-scenario="baseline" id="btn-baseline" role="radio" aria-checked="true" aria-label="现状情景：限高24米，绿地38%，慢行45%">
          <span class="sc-icon iconpark-icon" data-iconpark="ChartLine" data-size="22" aria-hidden="true"></span>
          <div class="sc-info">
            <div class="sc-name">现状情景</div>
            <div class="sc-desc">限高24m · 绿地38% · 慢行45%</div>
          </div>
        </button>
        <button class="btn-scenario" data-scenario="garden" id="btn-garden" role="radio" aria-checked="false" aria-label="园林优先：限高18米，绿地55%，慢行60%">
          <span class="sc-icon iconpark-icon" data-iconpark="Leaf" data-size="22" aria-hidden="true"></span>
          <div class="sc-info">
            <div class="sc-name">园林优先</div>
            <div class="sc-desc">限高18m · 绿地55% · 慢行60%</div>
          </div>
        </button>
        <button class="btn-scenario" data-scenario="balance" id="btn-balance" role="radio" aria-checked="false" aria-label="平衡发展：限高30米，绿地45%，慢行50%">
          <span class="sc-icon iconpark-icon" data-iconpark="Balance" data-size="22" aria-hidden="true"></span>
          <div class="sc-info">
            <div class="sc-name">平衡发展</div>
            <div class="sc-desc">限高30m · 绿地45% · 慢行50%</div>
          </div>
        </button>
      </div>

      <button class="btn-reset" id="btn-reset" aria-label="恢复默认参数"><span class="iconpark-icon" data-iconpark="Undo" data-size="16" aria-hidden="true"></span> 恢复默认</button>

      <div class="info-bar">
        <strong><span class="iconpark-icon" data-iconpark="Caution" data-size="16" aria-hidden="true"></span> 空间尺度说明：</strong>三条路径的核心机制锚定在古城及周边——限高令覆盖14.2km²古城（路径一）、冷岛辐射200–400m缓冲区（路径二）、步行圈约1000m半径（路径三）。古城尺度向全市尺度的外推存在假设条件。
      </div>
    </div>
  </aside>

  <!-- ===== CENTER: Map ===== -->
  <main class="map-area" id="map-area" aria-label="苏州碳平衡空间格局地图">
    <div id="map-container"></div>

    <!-- Loading state -->
    <div class="map-overlay-state" id="map-loading">
      <div class="map-state-bg"></div>
      <div class="map-state-content">
        <div class="map-spinner"></div>
        <div class="map-state-title">地图加载中…</div>
        <div class="map-state-desc">正在加载苏州碳平衡空间格局</div>
      </div>
    </div>

    <!-- Error / No-key state -->
    <div class="map-overlay-state hidden" id="map-no-key">
      <div class="map-state-bg"></div>
      <div class="map-state-content">
        <span class="map-state-icon iconpark-icon" data-iconpark="AreaMap" data-size="40" aria-hidden="true"></span>
        <div class="map-state-title">高德地图 API Key 未配置</div>
        <div class="map-state-desc">
          请将 <code>YOUR_AMAP_KEY</code> 替换为您的<br>高德地图 JS API 安全密钥<br>
          <a href="https://console.amap.com/dev/key/app" target="_blank" rel="noopener" style="color:var(--accent);">获取 Key →</a>
        </div>
      </div>
    </div>

    <!-- Map info overlay -->
    <div class="map-overlay" id="map-info">
      <strong>苏州</strong> · 碳平衡空间格局 · 九座古典园林
    </div>

    <!-- Map legend -->
    <div class="map-legend" id="map-legend">
      <div class="legend-item"><span class="legend-dot" style="background:#4A6741;"></span> 古典园林（世界文化遗产）</div>
      <div class="legend-item"><span class="legend-dot" style="background:rgba(74,103,65,0.3);border:2px solid #4A6741;"></span> 苏州行政边界</div>
      <div class="legend-item"><span class="legend-dot" style="background:rgba(139,110,90,0.3);border:2px solid #8B6E5A;"></span> 姑苏古城</div>
    </div>
  </main>

  <!-- ===== RIGHT PANEL: Dashboard ===== -->
  <aside class="panel-right" role="complementary" aria-label="碳平衡得分仪表盘">
    <div class="dash-header">
      <h2>碳平衡得分</h2>
    </div>
    <div class="dash-body">
      <!-- Score -->
      <div class="score-section">
        <div class="score-ring">
          <div class="score-value" id="score-value" aria-live="polite" aria-atomic="true">62<span class="score-max">/100</span></div>
          <div class="score-label">碳平衡综合得分</div>
        </div>
        <span class="score-grade grade-C" id="score-grade">C · 一般</span>
      </div>

      <!-- Gauge chart -->
      <div class="chart-box">
        <h3>得分仪表盘</h3>
        <div class="chart-container chart-container-large" id="chart-gauge" role="img" aria-label="碳平衡得分仪表盘"></div>
      </div>

      <!-- Path breakdown -->
      <div class="path-section">
        <h3 style="font-family:var(--font-heading);font-size:0.7rem;font-weight:700;color:var(--muted);letter-spacing:0.05em;text-transform:uppercase;margin-bottom:0.4rem;">路径贡献分解</h3>
        <div class="path-item">
          <span class="path-name"><span class="path-icon iconpark-icon" data-iconpark="City" data-size="18" aria-hidden="true"></span>形态约束<span class="path-weight">×45%</span></span>
          <div class="path-bar-bg"><div class="path-bar-fill" id="bar1" style="width:60%"></div></div>
          <span class="path-score" id="path1-score">60</span>
        </div>
        <div class="path-item">
          <span class="path-name"><span class="path-icon iconpark-icon" data-iconpark="Thermometer" data-size="18" aria-hidden="true"></span>冷岛效应<span class="path-weight">×45%</span></span>
          <div class="path-bar-bg"><div class="path-bar-fill" id="bar2" style="width:55%"></div></div>
          <span class="path-score" id="path2-score">55</span>
        </div>
        <div class="path-item">
          <span class="path-name"><span class="path-icon iconpark-icon" data-iconpark="People" data-size="18" aria-hidden="true"></span>慢行替代<span class="path-weight">×10%</span></span>
          <div class="path-bar-bg"><div class="path-bar-fill" id="bar3" style="width:40%"></div></div>
          <span class="path-score" id="path3-score">40</span>
        </div>
      </div>

      <!-- Comparison chart -->
      <div class="chart-box">
        <h3>情景对比</h3>
        <div class="chart-container" id="chart-compare" role="img" aria-label="情景碳平衡得分对比"></div>
      </div>

      <!-- Narrative -->
      <div class="narrative" id="narrative-text" aria-live="polite">
        基于现状参数，苏州碳平衡得分为62分。古城24米限高令维持了低层建筑形态，节省约25%运行能耗。绿地覆盖率38%提供了中等冷岛效应，园林周边降温约3–4°C。慢行网络覆盖率45%的交通减排贡献有限。
      </div>
    </div>
  </aside>
</div>

<script>
// ============================================================
// 碳平衡规划师 · 核心计算引擎 v2.0
// 基于第三章三条碳避免路径的空间机制
// ============================================================

(function() {
  'use strict';

  // --- DOM references ---
  const $ = function(s) { return document.querySelector(s); };
  const slHeight = $('#slider-height');
  const slGreen = $('#slider-green');
  const slWalk = $('#slider-walk');
  const valHeight = $('#val-height');
  const valGreen = $('#val-green');
  const valWalk = $('#val-walk');
  const scoreValue = $('#score-value');
  const scoreGrade = $('#score-grade');
  const path1Score = $('#path1-score');
  const path2Score = $('#path2-score');
  const path3Score = $('#path3-score');
  const bar1 = $('#bar1');
  const bar2 = $('#bar2');
  const bar3 = $('#bar3');
  const narrativeText = $('#narrative-text');
  const mapLoading = $('#map-loading');
  const mapNoKey = $('#map-no-key');
  const mapLegend = $('#map-legend');

  // --- State ---
  var state = {
    height: 24,
    green: 38,
    walk: 45,
    activeScenario: 'baseline',
    scenarios: {
      baseline: { height: 24, green: 38, walk: 45 },
      garden:   { height: 18, green: 55, walk: 60 },
      balance:  { height: 30, green: 45, walk: 50 }
    }
  };

  // --- Carbon Balance Calculation ---
  // Weights based on Chapter 3 empirical findings:
  // Path 1 (形态约束): 45% — strongest carbon avoidance path
  // Path 2 (冷岛效应): 45% — strong empirical evidence
  // Path 3 (慢行替代): 10% — weak/diagnostic only
  var W = { height: 0.45, green: 0.45, walk: 0.10 };

  function calcPath1Score(h) {
    // Building height: lower = better
    // 24m baseline = 60 points, 12m = 100 points, 60m = 0 points
    var score = Math.max(0, Math.min(100, 100 - (h - 12) / 48 * 100));
    return Math.round(score);
  }

  function calcPath2Score(g) {
    // Green coverage: higher = better
    // 38% baseline = 55 points, 70% = 100 points, 20% = 0 points
    var score = Math.max(0, Math.min(100, (g - 20) / 50 * 100));
    return Math.round(score);
  }

  function calcPath3Score(w) {
    // Walk network coverage: higher = better, but effect is weak
    // 45% baseline = 40 points, 90% = 100 points, 20% = 0 points
    var score = Math.max(0, Math.min(100, (w - 20) / 70 * 100));
    return Math.round(score);
  }

  function calcTotalScore(h, g, w) {
    var p1 = calcPath1Score(h);
    var p2 = calcPath2Score(g);
    var p3 = calcPath3Score(w);
    var total = Math.round(p1 * W.height + p2 * W.green + p3 * W.walk);
    return { total: total, p1: p1, p2: p2, p3: p3 };
  }

  function getGrade(score) {
    if (score >= 80) return { grade: 'A', text: 'A · 优秀', cls: 'grade-A' };
    if (score >= 65) return { grade: 'B', text: 'B · 良好', cls: 'grade-B' };
    if (score >= 50) return { grade: 'C', text: 'C · 一般', cls: 'grade-C' };
    return { grade: 'D', text: 'D · 需改善', cls: 'grade-D' };
  }

  function generateNarrative(h, g, w, result) {
    var parts = [];
    var total = result.total;

    // Building height narrative
    if (h <= 20) {
      parts.push('建筑限高严格控制在' + h + '米，古城低层形态优势显著，运行能耗比高层建筑低约' + Math.round(25 + (24 - h) * 0.5) + '%');
    } else if (h <= 30) {
      parts.push('建筑限高适度放宽至' + h + '米，运行能耗优势有所减弱，但仍优于高层建筑形态');
    } else {
      parts.push('建筑限高放宽至' + h + '米，建筑形态趋于高层化，运行能耗优势明显减弱，接近或低于外围新城水平');
    }

    // Green coverage narrative
    if (g >= 55) {
      parts.push('绿地覆盖率提升至' + g + '%，冷岛效应显著增强，园林降温辐射范围预计扩展至400米以上，周边制冷能耗节省约15%–20%');
    } else if (g >= 42) {
      parts.push('绿地覆盖率' + g + '%，冷岛效应中等，园林周边降温约3–4°C，为周边节省约10%–15%制冷能耗');
    } else {
      parts.push('绿地覆盖率' + g + '%，冷岛效应有限，园林降温辐射范围约200米，制冷能耗节省有限');
    }

    // Slow travel narrative
    if (w >= 65) {
      parts.push('慢行网络覆盖率达' + w + '%，步行替代驾车的潜力有所提升，但由于路径三效应微弱（八园合计年均仅约18.3吨），在碳平衡得分中的贡献相对有限');
    } else {
      parts.push('慢行网络覆盖率' + w + '%，交通维度的碳避免效应微弱，文化碳避免在总量上贡献有限');
    }

    // Summary
    if (total >= 80) {
      parts.push('综合碳平衡得分' + total + '分，属于优秀水平，三条路径的协同效应显著.');
    } else if (total >= 65) {
      parts.push('综合碳平衡得分' + total + '分，还有优化空间，建议在保持建筑高度约束的同时，进一步提升绿地覆盖率.');
    } else if (total >= 50) {
      parts.push('综合碳平衡得分' + total + '分，处于一般水平，建议加强绿地建设和建筑高度管控.');
    } else {
      parts.push('综合碳平衡得分' + total + '分，需改善，建议收紧建筑高度约束并大幅提升绿地覆盖率.');
    }

    return parts.join('。');
  }

  // --- Update UI ---
  function updateUI() {
    var result = calcTotalScore(state.height, state.green, state.walk);
    var grade = getGrade(result.total);

    // Value displays
    valHeight.textContent = state.height + 'm';
    valGreen.textContent = state.green + '%';
    valWalk.textContent = state.walk + '%';

    // Score
    scoreValue.innerHTML = result.total + '<span class="score-max">/100</span>';
    scoreValue.className = 'score-value';
    if (result.total < 50) scoreValue.classList.add('danger');
    else if (result.total < 65) scoreValue.classList.add('warning');

    // Grade
    scoreGrade.textContent = grade.text;
    scoreGrade.className = 'score-grade ' + grade.cls;

    // Path scores with bars
    path1Score.textContent = result.p1;
    path2Score.textContent = result.p2;
    path3Score.textContent = result.p3;
    bar1.style.width = result.p1 + '%';
    bar2.style.width = result.p2 + '%';
    bar3.style.width = result.p3 + '%';

    // Color code path scores
    path1Score.className = 'path-score' + (result.p1 < 50 ? ' danger' : result.p1 < 65 ? ' warning' : '');
    path2Score.className = 'path-score' + (result.p2 < 50 ? ' danger' : result.p2 < 65 ? ' warning' : '');
    path3Score.className = 'path-score' + (result.p3 < 50 ? ' danger' : result.p3 < 65 ? ' warning' : '');

    // Narrative
    narrativeText.textContent = generateNarrative(state.height, state.green, state.walk, result);

    // Charts
    updateGauge(result.total);
    updateCompareChart(result);
  }

  // --- Event Handlers ---
  function onSliderChange() {
    state.height = parseInt(slHeight.value);
    state.green = parseInt(slGreen.value);
    state.walk = parseInt(slWalk.value);
    state.activeScenario = 'custom';
    updateScenarioButtons();
    updateUI();
    updateAria();
  }

  slHeight.addEventListener('input', onSliderChange);
  slGreen.addEventListener('input', onSliderChange);
  slWalk.addEventListener('input', onSliderChange);

  function updateAria() {
    slHeight.setAttribute('aria-valuenow', state.height);
    slHeight.setAttribute('aria-valuetext', state.height + '米');
    slGreen.setAttribute('aria-valuenow', state.green);
    slGreen.setAttribute('aria-valuetext', state.green + '%');
    slWalk.setAttribute('aria-valuenow', state.walk);
    slWalk.setAttribute('aria-valuetext', state.walk + '%');
  }

  function updateScenarioButtons() {
    var buttons = document.querySelectorAll('.btn-scenario');
    for (var i = 0; i < buttons.length; i++) {
      var btn = buttons[i];
      var isActive = btn.dataset.scenario === state.activeScenario;
      btn.classList.toggle('active', isActive);
      btn.setAttribute('aria-checked', isActive ? 'true' : 'false');
    }
  }

  // Scenario button clicks
  var scenarioButtons = document.querySelectorAll('.btn-scenario');
  for (var i = 0; i < scenarioButtons.length; i++) {
    scenarioButtons[i].addEventListener('click', function() {
      var key = this.dataset.scenario;
      var s = state.scenarios[key];
      if (!s) return;

      state.activeScenario = key;
      state.height = s.height;
      state.green = s.green;
      state.walk = s.walk;

      slHeight.value = s.height;
      slGreen.value = s.green;
      slWalk.value = s.walk;

      updateScenarioButtons();
      updateUI();
      updateAria();
    });
  }

  // Reset button
  $('#btn-reset').addEventListener('click', function() {
    var s = state.scenarios.baseline;
    state.activeScenario = 'baseline';
    state.height = s.height;
    state.green = s.green;
    state.walk = s.walk;

    slHeight.value = s.height;
    slGreen.value = s.green;
    slWalk.value = s.walk;

    updateScenarioButtons();
    updateUI();
    updateAria();
  });

  // Keyboard support for sliders
  [slHeight, slGreen, slWalk].forEach(function(sl) {
    sl.addEventListener('keydown', function(e) {
      if (e.key === 'ArrowLeft' || e.key === 'ArrowDown') {
        e.preventDefault();
        this.value = Math.max(parseInt(this.min), parseInt(this.value) - parseInt(this.step));
        onSliderChange();
      } else if (e.key === 'ArrowRight' || e.key === 'ArrowUp') {
        e.preventDefault();
        this.value = Math.min(parseInt(this.max), parseInt(this.value) + parseInt(this.step));
        onSliderChange();
      }
    });
  });

  // --- ECharts ---
  var gaugeChart, compareChart;

  function initCharts() {
    var gaugeEl = document.getElementById('chart-gauge');
    var compareEl = document.getElementById('chart-compare');
    if (gaugeEl) gaugeChart = echarts.init(gaugeEl);
    if (compareEl) compareChart = echarts.init(compareEl);
    updateGauge(62);
    updateCompareChart(calcTotalScore(24, 38, 45));
    window.addEventListener('resize', function() {
      if (gaugeChart) gaugeChart.resize();
      if (compareChart) compareChart.resize();
    });
  }

  function updateGauge(score) {
    if (!gaugeChart) return;
    gaugeChart.setOption({
      series: [{
        type: 'gauge',
        startAngle: 210,
        endAngle: -30,
        center: ['50%', '58%'],
        radius: '88%',
        min: 0,
        max: 100,
        splitNumber: 10,
        progress: {
          show: true,
          width: 14,
          roundCap: true,
          itemStyle: {
            color: {
              type: 'linear',
              x: 0, y: 0, x2: 1, y2: 0,
              colorStops: [
                { offset: 0, color: '#B8453A' },
                { offset: 0.3, color: '#C47A3A' },
                { offset: 0.5, color: '#5B8C5A' },
                { offset: 0.7, color: '#4A6741' },
                { offset: 1, color: '#1F2E1A' }
              ]
            }
          }
        },
        axisLine: {
          lineStyle: {
            width: 14,
            color: [
              [0.3, '#F0D0C8'], [0.5, '#F0E0D0'],
              [0.7, '#D0E0C8'], [0.85, '#C0D8B8'], [1, '#B0C8A8']
            ]
          }
        },
        pointer: {
          length: '60%', width: 6,
          itemStyle: { color: '#2A241E' }
        },
        axisTick: { distance: -14, length: 6, lineStyle: { width: 1, color: '#999' } },
        splitLine: { distance: -18, length: 14, lineStyle: { width: 2, color: '#999' } },
        axisLabel: {
          color: '#8A8070', fontSize: 9, distance: 22,
          fontFamily: 'JetBrainsMono, monospace'
        },
        detail: {
          valueAnimation: true,
          formatter: '{value}',
          fontSize: 26,
          fontWeight: 'bold',
          color: '#4A6741',
          offsetCenter: [0, '72%'],
          fontFamily: 'BricolageGrotesque, sans-serif'
        },
        title: { show: false },
        data: [{ value: score }]
      }]
    });
  }

  function updateCompareChart(currentResult) {
    if (!compareChart) return;
    var baseline = calcTotalScore(24, 38, 45);
    var garden = calcTotalScore(18, 55, 60);
    var balance = calcTotalScore(30, 45, 50);

    var data = [
      { value: baseline.total, itemStyle: { color: '#8BA88A', borderRadius: [4,4,0,0] } },
      { value: garden.total, itemStyle: { color: '#4A6741', borderRadius: [4,4,0,0] } },
      { value: balance.total, itemStyle: { color: '#5B8C5A', borderRadius: [4,4,0,0] } },
      { value: currentResult.total, itemStyle: { color: '#C47A3A', borderRadius: [4,4,0,0] } }
    ];

    compareChart.setOption({
      tooltip: {
        trigger: 'axis',
        backgroundColor: '#fff',
        borderColor: '#D8D0C0',
        textStyle: { color: '#2A241E', fontSize: 12, fontFamily: 'CrimsonPro, sans-serif' }
      },
      grid: { left: '6%', right: '6%', top: 12, bottom: 24 },
      xAxis: {
        type: 'category',
        data: ['现状', '园林优先', '平衡发展', '当前'],
        axisLabel: { fontSize: 10, color: '#8A8070', fontFamily: 'BricolageGrotesque, sans-serif' },
        axisLine: { lineStyle: { color: '#D8D0C0' } },
        axisTick: { show: false }
      },
      yAxis: {
        type: 'value',
        min: 0,
        max: 100,
        splitLine: { lineStyle: { color: '#F0EDE6' } },
        axisLabel: { fontSize: 9, color: '#8A8070', fontFamily: 'JetBrainsMono, monospace' }
      },
      series: [{
        type: 'bar',
        data: data,
        barWidth: '45%',
        emphasis: {
          itemStyle: { opacity: 0.85 }
        },
        label: {
          show: true,
          position: 'top',
          fontSize: 11,
          fontWeight: 'bold',
          color: '#2A241E',
          fontFamily: 'JetBrainsMono, monospace',
          formatter: '{c}'
        }
      }]
    });
  }

  // --- Map Initialization ---
  var map = null;
  var mapInitialized = false;

  function initMap() {
    if (typeof AMap === 'undefined') {
      showMapState('no-key');
      return;
    }

    try {
      map = new AMap.Map('map-container', {
        center: [120.62, 31.32],
        zoom: 12,
        mapStyle: 'amap://styles/light',
        features: ['bg', 'road', 'building', 'point'],
        viewMode: '2D',
        resizeEnable: true,
        renderOnMoving: true
      });

      map.addControl(new AMap.Scale({ position: { bottom: '10px', left: '10px' } }));
      map.addControl(new AMap.ToolBar({ position: { top: '10px', right: '10px' } }));

      map.on('complete', function() {
        mapLoading.classList.add('hidden');
        mapLegend.classList.add('visible');
        mapInitialized = true;
      });

      map.on('error', function() {
        mapLoading.classList.add('hidden');
        showMapState('no-key');
      });

      // Draw Suzhou approximate boundary
      var suzhouBoundary = [
        [120.37, 31.48], [120.95, 31.48], [121.08, 31.25],
        [120.98, 31.05], [120.78, 30.90], [120.45, 30.88],
        [120.25, 30.95], [120.12, 31.05], [120.08, 31.18],
        [120.15, 31.32], [120.37, 31.48]
      ];

      var boundaryPolygon = new AMap.Polygon({
        path: suzhouBoundary,
        fillColor: 'rgba(74,103,65,0.05)',
        fillOpacity: 0.35,
        strokeColor: '#4A6741',
        strokeWeight: 2.5,
        strokeStyle: 'dashed',
        strokeOpacity: 0.6,
        strokeDasharray: [8, 4]
      });
      map.add(boundaryPolygon);

      // Old City boundary (approximate)
      var oldCity = [
        [120.615, 31.337], [120.643, 31.337], [120.643, 31.308],
        [120.615, 31.308], [120.615, 31.337]
      ];
      var oldCityPolygon = new AMap.Polygon({
        path: oldCity,
        fillColor: 'rgba(139,110,90,0.12)',
        fillOpacity: 0.45,
        strokeColor: '#8B6E5A',
        strokeWeight: 2.5,
        strokeStyle: 'solid',
        strokeOpacity: 0.7
      });
      map.add(oldCityPolygon);

      // Garden markers with actual spatial data
      var gardens = [
        { name: '拙政园',   lng: 120.629, lat: 31.325, area: '5.2 ha', carbon: '7.8 tCO₂/yr' },
        { name: '留园',     lng: 120.588, lat: 31.317, area: '2.3 ha', carbon: '5.2 tCO₂/yr' },
        { name: '沧浪亭',   lng: 120.622, lat: 31.298, area: '1.1 ha', carbon: '4.4 tCO₂/yr' },
        { name: '狮子林',   lng: 120.631, lat: 31.324, area: '1.1 ha', carbon: '3.1 tCO₂/yr' },
        { name: '耦园',     lng: 120.635, lat: 31.322, area: '0.8 ha', carbon: '7.4 tCO₂/yr' },
        { name: '网师园',   lng: 120.632, lat: 31.300, area: '0.6 ha', carbon: '2.8 tCO₂/yr' },
        { name: '艺圃',     lng: 120.612, lat: 31.318, area: '0.4 ha', carbon: '2.1 tCO₂/yr' },
        { name: '环秀山庄', lng: 120.618, lat: 31.316, area: '0.2 ha', carbon: '1.6 tCO₂/yr' },
        { name: '退思园',   lng: 120.716, lat: 31.155, area: '0.7 ha', carbon: '2.3 tCO₂/yr' }
      ];

      gardens.forEach(function(g) {
        var marker = new AMap.Marker({
          position: [g.lng, g.lat],
          title: g.name,
          label: {
            content: '<div style="font-size:11px;color:#4A6741;font-weight:700;text-shadow:0 1px 2px #fff;white-space:nowrap;margin-top:-20px;">' + g.name + '</div>',
            direction: 'top'
          },
          icon: new AMap.Icon({
            size: new AMap.Size(18, 18),
            image: 'data:image/svg+xml,' + encodeURIComponent(
              '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="#4A6741" opacity="0.85"/><circle cx="12" cy="12" r="5" fill="#8BA88A"/><circle cx="12" cy="12" r="2" fill="#1F2E1A"/></svg>'
            ),
            imageSize: new AMap.Size(18, 18)
          }),
          offset: new AMap.Pixel(-9, -9),
          zIndex: 100
        });

        marker.on('click', function() {
          var info = new AMap.InfoWindow({
            content: '<div style="font-family:sans-serif;padding:6px 10px;font-size:13px;min-width:120px;">' +
              '<strong style="color:#4A6741;">' + g.name + '</strong>' +
              '<br><span style="font-size:11px;color:#8A8070;">古典园林 · 世界文化遗产</span>' +
              '<br><span style="font-size:10px;color:#8A8070;">面积: ' + g.area + ' | 碳汇: ' + g.carbon + '</span>' +
              '</div>',
            offset: new AMap.Pixel(0, -28)
          });
          info.open(map, marker.getPosition());
        });

        map.add(marker);
      });

      map.setFitView(null, false, [60, 60, 60, 60]);
    } catch(e) {
      showMapState('no-key');
    }
  }

  function showMapState(state) {
    mapLoading.classList.add('hidden');
    if (state === 'no-key') {
      mapNoKey.classList.remove('hidden');
    }
  }

  // --- Initialize ---
  initCharts();
  updateUI();

  // Try map initialization
  try {
    initMap();
  } catch(e) {
    showMapState('no-key');
  }

  // Handle window resize for responsive chart
  var resizeTimeout;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(function() {
      if (gaugeChart) gaugeChart.resize();
      if (compareChart) compareChart.resize();
    }, 150);
  });

})();
</script>

</body>
</html>